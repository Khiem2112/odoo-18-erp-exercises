<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_erp_delivery" model="ir.module.category">
        <field name="name">ERP Delivery</field>
        <field name="description">ERP implementation delivery roles</field>
        <field name="sequence">35</field>
    </record>

    <record id="group_erp_delivery_user" model="res.groups">
        <field name="name">ERP Delivery User</field>
        <field name="category_id" ref="module_category_erp_delivery"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('project.group_project_milestone')), (4, ref('project.group_project_stages'))]"/>
    </record>

    <record id="group_erp_delivery_consultant" model="res.groups">
        <field name="name">ERP Delivery Consultant</field>
        <field name="category_id" ref="module_category_erp_delivery"/>
        <field name="implied_ids" eval="[(4, ref('group_erp_delivery_user')), (4, ref('project.group_project_user'))]"/>
    </record>

    <record id="group_erp_delivery_manager" model="res.groups">
        <field name="name">ERP Delivery Manager</field>
        <field name="category_id" ref="module_category_erp_delivery"/>
        <field name="implied_ids" eval="[(4, ref('group_erp_delivery_consultant')), (4, ref('project.group_project_manager'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <data noupdate="1">
        <record id="rule_erp_partner_company" model="ir.rule">
            <field name="name">ERP customers: allowed companies</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="domain_force">
                ['|', ('is_erp_customer', '=', False), ('company_id', 'in', company_ids)]
            </field>
        </record>

        <record id="rule_erp_project_assignment_read" model="ir.rule">
            <field name="name">ERP projects: consultant assignment restriction</field>
            <field name="model_id" ref="project.model_project_project"/>
            <field name="domain_force">[(1, '=', 1)] if (not user.has_group('erp_delivery_management.group_erp_delivery_consultant') or user.has_group('erp_delivery_management.group_erp_delivery_manager')) else ['|', ('is_erp_project', '=', False), '|', ('user_id', '=', user.id), ('team_member_ids', 'in', [user.id])]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        <record id="rule_erp_project_assignment_write" model="ir.rule">
            <field name="name">ERP projects: assigned consultants may write</field>
            <field name="model_id" ref="project.model_project_project"/>
            <field name="domain_force">[(1, '=', 1)] if user.has_group('erp_delivery_management.group_erp_delivery_manager') else (['|', ('is_erp_project', '=', False), '|', ('user_id', '=', user.id), ('team_member_ids', 'in', [user.id])] if user.has_group('erp_delivery_management.group_erp_delivery_consultant') else [('is_erp_project', '=', False)])</field>
            <field name="perm_read" eval="False"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        <record id="rule_erp_project_create" model="ir.rule">
            <field name="name">ERP projects: manager creation</field>
            <field name="model_id" ref="project.model_project_project"/>
            <field name="domain_force">[(1, '=', 1)] if user.has_group('erp_delivery_management.group_erp_delivery_manager') else [('is_erp_project', '=', False)]</field>
            <field name="perm_read" eval="False"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        <record id="rule_erp_project_unlink" model="ir.rule">
            <field name="name">ERP projects: manager deletion</field>
            <field name="model_id" ref="project.model_project_project"/>
            <field name="domain_force">[(1, '=', 1)] if user.has_group('erp_delivery_management.group_erp_delivery_manager') else [('is_erp_project', '=', False)]</field>
            <field name="perm_read" eval="False"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="rule_erp_task_assignment_read" model="ir.rule">
            <field name="name">ERP tasks: consultant assignment restriction</field>
            <field name="model_id" ref="project.model_project_task"/>
            <field name="domain_force">[(1, '=', 1)] if (not user.has_group('erp_delivery_management.group_erp_delivery_consultant') or user.has_group('erp_delivery_management.group_erp_delivery_manager')) else ['|', ('project_id.is_erp_project', '=', False), '|', ('project_id.user_id', '=', user.id), ('project_id.team_member_ids', 'in', [user.id])]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        <record id="rule_erp_task_assignment_write" model="ir.rule">
            <field name="name">ERP tasks: assigned consultants may change tasks</field>
            <field name="model_id" ref="project.model_project_task"/>
            <field name="domain_force">[(1, '=', 1)] if user.has_group('erp_delivery_management.group_erp_delivery_manager') else (['|', ('project_id.is_erp_project', '=', False), '|', ('project_id.user_id', '=', user.id), ('project_id.team_member_ids', 'in', [user.id])] if user.has_group('erp_delivery_management.group_erp_delivery_consultant') else [('project_id.is_erp_project', '=', False)])</field>
            <field name="perm_read" eval="False"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        <record id="rule_erp_task_unlink" model="ir.rule">
            <field name="name">ERP tasks: manager deletion</field>
            <field name="model_id" ref="project.model_project_task"/>
            <field name="domain_force">[(1, '=', 1)] if user.has_group('erp_delivery_management.group_erp_delivery_manager') else [('project_id.is_erp_project', '=', False)]</field>
            <field name="perm_read" eval="False"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="rule_erp_milestone_assignment_read" model="ir.rule">
            <field name="name">ERP milestones: consultant assignment restriction</field>
            <field name="model_id" ref="project.model_project_milestone"/>
            <field name="domain_force">[(1, '=', 1)] if (not user.has_group('erp_delivery_management.group_erp_delivery_consultant') or user.has_group('erp_delivery_management.group_erp_delivery_manager')) else ['|', ('project_id.is_erp_project', '=', False), '|', ('project_id.user_id', '=', user.id), ('project_id.team_member_ids', 'in', [user.id])]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        <record id="rule_erp_milestone_assignment_write" model="ir.rule">
            <field name="name">ERP milestones: assigned consultants may change milestones</field>
            <field name="model_id" ref="project.model_project_milestone"/>
            <field name="domain_force">[(1, '=', 1)] if user.has_group('erp_delivery_management.group_erp_delivery_manager') else (['|', ('project_id.is_erp_project', '=', False), '|', ('project_id.user_id', '=', user.id), ('project_id.team_member_ids', 'in', [user.id])] if user.has_group('erp_delivery_management.group_erp_delivery_consultant') else [('project_id.is_erp_project', '=', False)])</field>
            <field name="perm_read" eval="False"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        <record id="rule_erp_milestone_unlink" model="ir.rule">
            <field name="name">ERP milestones: manager deletion</field>
            <field name="model_id" ref="project.model_project_milestone"/>
            <field name="domain_force">[(1, '=', 1)] if user.has_group('erp_delivery_management.group_erp_delivery_manager') else [('project_id.is_erp_project', '=', False)]</field>
            <field name="perm_read" eval="False"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="rule_erp_project_line_company" model="ir.rule">
            <field name="name">ERP project lines: allowed companies</field>
            <field name="model_id" ref="model_erp_project_line"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_erp_project_line_assignment" model="ir.rule">
            <field name="name">ERP project lines: consultant assignment restriction</field>
            <field name="model_id" ref="model_erp_project_line"/>
            <field name="global" eval="True"/>
            <field name="domain_force">[(1, '=', 1)] if (not user.has_group('erp_delivery_management.group_erp_delivery_consultant') or user.has_group('erp_delivery_management.group_erp_delivery_manager')) else ['|', ('project_id.user_id', '=', user.id), ('project_id.team_member_ids', 'in', [user.id])]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>
    </data>
</odoo>

