<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_erp_solution_list" model="ir.ui.view">
        <field name="name">erp.solution.list</field>
        <field name="model">erp.solution</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="solution_group"/>
                <field name="standard_effort"/>
                <field name="effort_uom"/>
                <field name="service_currency_id" column_invisible="True"/>
                <field name="service_price"/>
                <field name="internal_cost_currency_id" column_invisible="True"/>
                <field name="internal_cost" widget="monetary" options="{'currency_field': 'internal_cost_currency_id'}"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_erp_solution_form" model="ir.ui.view">
        <field name="name">erp.solution.form</field>
        <field name="model">erp.solution</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <field name="image_1920" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="solution_group"/>
                            <field name="active"/>
                            <field name="standard_effort"/>
                            <field name="effort_uom"/>
                        </group>
                        <group>
                            <field name="service_currency_id"/>
                            <field name="service_price"/>
                            <field name="internal_cost_currency_id"/>
                            <field name="internal_cost" widget="monetary" options="{'currency_field': 'internal_cost_currency_id'}"/>
                            <field name="document_filename" invisible="1"/>
                            <field name="document" filename="document_filename"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Summary"><field name="short_description"/></page>
                        <page string="Description"><field name="description"/></page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_erp_solution_search" model="ir.ui.view">
        <field name="name">erp.solution.search</field>
        <field name="model">erp.solution</field>
        <field name="arch" type="xml">
            <search>
                <field name="code"/>
                <field name="name"/>
                <field name="solution_group"/>
                <filter name="active" string="Active" domain="[('active', '=', True)]"/>
                <filter name="group_solution_group" string="Solution Group" context="{'group_by': 'solution_group'}"/>
            </search>
        </field>
    </record>

    <record id="action_erp_solution" model="ir.actions.act_window">
        <field name="name">ERP Solutions</field>
        <field name="res_model">erp.solution</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_erp_solution_search"/>
    </record>
</odoo>

