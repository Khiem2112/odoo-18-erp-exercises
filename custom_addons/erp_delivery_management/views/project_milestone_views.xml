<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_milestone_form_erp_delivery" model="ir.ui.view">
        <field name="name">project.milestone.form.erp.delivery</field>
        <field name="model">project.milestone</field>
        <field name="inherit_id" ref="project.project_milestone_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form/sheet/group" position="after">
                <group string="ERP Delivery" invisible="not is_erp_delivery_milestone">
                    <field name="is_erp_delivery_milestone" invisible="1"/>
                    <field name="company_id" invisible="1"/>
                    <field name="project_line_id" domain="[('project_id', '=', project_id)]"/>
                    <field name="is_mandatory_for_golive"/>
                    <field name="risk_level"/>
                    <field name="risk_status"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="view_milestone_list_erp_delivery" model="ir.ui.view">
        <field name="name">project.milestone.list.erp.delivery</field>
        <field name="model">project.milestone</field>
        <field name="inherit_id" ref="project.project_milestone_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='deadline']" position="after">
                <field name="is_mandatory_for_golive" optional="show"/>
                <field name="risk_level" optional="show"/>
                <field name="risk_status" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>

