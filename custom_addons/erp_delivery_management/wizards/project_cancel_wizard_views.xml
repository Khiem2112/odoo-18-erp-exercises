<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_erp_project_cancel_wizard_form" model="ir.ui.view">
        <field name="name">erp.project.cancel.wizard.form</field>
        <field name="model">erp.project.cancel.wizard</field>
        <field name="arch" type="xml">
            <form string="Cancel ERP Project">
                <group>
                    <field name="project_id" invisible="1"/>
                    <field name="cancellation_reason" placeholder="Explain why this project is being cancelled..."/>
                </group>
                <footer>
                    <button name="action_confirm_cancel" type="object" string="Confirm Cancellation" class="btn-primary"/>
                    <button string="Discard" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
