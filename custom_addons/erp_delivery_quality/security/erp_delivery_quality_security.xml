<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="rule_quality_check_company" model="ir.rule">
        <field name="name">ERP quality checks: allowed companies</field>
        <field name="model_id" ref="model_erp_quality_check"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_quality_check_assignment" model="ir.rule">
        <field name="name">ERP quality checks: consultant assignment</field>
        <field name="model_id" ref="model_erp_quality_check"/>
        <field name="domain_force">[(1, '=', 1)] if (not user.has_group('erp_delivery_management.group_erp_delivery_consultant') or user.has_group('erp_delivery_management.group_erp_delivery_manager')) else ['|', ('project_id.user_id', '=', user.id), ('project_id.team_member_ids', 'in', [user.id])]</field>
    </record>
    <record id="rule_quality_gate_company" model="ir.rule">
        <field name="name">ERP quality gates: allowed companies</field>
        <field name="model_id" ref="model_erp_quality_gate"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_quality_gate_assignment" model="ir.rule">
        <field name="name">ERP quality gates: consultant assignment</field>
        <field name="model_id" ref="model_erp_quality_gate"/>
        <field name="domain_force">[(1, '=', 1)] if user.has_group('erp_delivery_management.group_erp_delivery_manager') else ['|', ('project_id.user_id', '=', user.id), ('project_id.team_member_ids', 'in', [user.id])]</field>
    </record>
    <record id="rule_quality_gate_line_company" model="ir.rule">
        <field name="name">ERP quality gate lines: allowed companies</field>
        <field name="model_id" ref="model_erp_quality_gate_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_quality_gate_line_assignment" model="ir.rule">
        <field name="name">ERP quality gate lines: consultant assignment</field>
        <field name="model_id" ref="model_erp_quality_gate_line"/>
        <field name="domain_force">[(1, '=', 1)] if user.has_group('erp_delivery_management.group_erp_delivery_manager') else ['|', ('project_id.user_id', '=', user.id), ('project_id.team_member_ids', 'in', [user.id])]</field>
    </record>
</odoo>

