<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_erp_quality_gate_list" model="ir.ui.view">
        <field name="name">erp.quality.gate.list</field>
        <field name="model">erp.quality.gate</field>
        <field name="arch" type="xml">
            <list decoration-success="decision_state == 'approved'" decoration-danger="decision_state == 'rejected'" decoration-warning="decision_state == 'pending'" create="0" edit="0" delete="0">
                <field name="name"/>
                <field name="project_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="state"/>
                <field name="decision_state"/>
                <field name="is_override" optional="show"/>
                <field name="is_stale" optional="show"/>
                <field name="score"/>
                <field name="threshold"/>
                <field name="evaluator_id" widget="many2one_avatar_user"/>
                <field name="evaluated_at"/>
            </list>
        </field>
    </record>

    <record id="view_erp_quality_gate_form" model="ir.ui.view">
        <field name="name">erp.quality.gate.form</field>
        <field name="model">erp.quality.gate</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <header>
                    <button name="action_open_decision_wizard" type="object" string="Approve" class="oe_highlight" groups="erp_delivery_management.group_erp_delivery_manager" context="{'quality_gate_decision': 'approved'}" invisible="decision_state != 'pending' or is_stale"/>
                    <button name="action_open_decision_wizard" type="object" string="Reject" groups="erp_delivery_management.group_erp_delivery_manager" context="{'quality_gate_decision': 'rejected'}" invisible="decision_state != 'pending' or is_stale"/>
                    <field name="decision_state" widget="statusbar" statusbar_visible="pending,approved,rejected"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="project_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="state"/>
                            <field name="decision_state"/>
                            <field name="is_override"/>
                            <field name="is_stale"/>
                            <field name="score"/>
                            <field name="threshold"/>
                        </group>
                        <group>
                            <field name="task_score"/>
                            <field name="risk_score"/>
                            <field name="line_score"/>
                            <field name="checklist_score"/>
                            <field name="evaluator_id" widget="many2one_avatar_user"/>
                            <field name="evaluated_at"/>
                            <field name="decision_by_id" widget="many2one_avatar_user" invisible="decision_state == 'pending'"/>
                            <field name="decided_at" invisible="decision_state == 'pending'"/>
                        </group>
                    </group>
                    <group string="Decision Reason" invisible="not decision_reason">
                        <field name="decision_reason" nolabel="1"/>
                    </group>
                    <group string="Blockers">
                        <field name="blocker_snapshot" nolabel="1"/>
                    </group>
                    <separator string="Project Line Snapshots"/>
                    <field name="line_snapshot_ids" readonly="1">
                        <list create="0" edit="0" delete="0" decoration-success="state == 'passed'" decoration-danger="state == 'failed'">
                            <field name="solution_name"/>
                            <field name="consultant_name"/>
                            <field name="state"/>
                            <field name="score"/>
                            <field name="task_score" optional="hide"/>
                            <field name="risk_score" optional="hide"/>
                            <field name="acceptance_score" optional="hide"/>
                            <field name="checklist_score" optional="hide"/>
                            <field name="blocker_snapshot" optional="show"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_erp_quality_gate_search" model="ir.ui.view">
        <field name="name">erp.quality.gate.search</field>
        <field name="model">erp.quality.gate</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="project_id"/>
                <field name="evaluator_id"/>
                <field name="decision_by_id"/>
                <filter name="passed" string="Passed" domain="[('state', '=', 'passed')]"/>
                <filter name="failed" string="Failed" domain="[('state', '=', 'failed')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_project" string="Project" context="{'group_by': 'project_id'}"/>
                    <filter name="group_state" string="State" context="{'group_by': 'state'}"/>
                    <filter name="group_decision" string="Decision" context="{'group_by': 'decision_state'}"/>
                    <filter name="group_company" string="Company" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_erp_quality_gate" model="ir.actions.act_window">
        <field name="name">Quality Gate History</field>
        <field name="res_model">erp.quality.gate</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_erp_quality_gate_search"/>
    </record>

    <menuitem id="menu_erp_quality_gate" name="Quality Gates" parent="erp_delivery_management.menu_erp_delivery_root" action="action_erp_quality_gate" sequence="30" groups="erp_delivery_management.group_erp_delivery_consultant"/>
</odoo>

