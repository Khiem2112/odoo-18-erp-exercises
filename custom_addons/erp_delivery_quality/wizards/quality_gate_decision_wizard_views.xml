<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_erp_quality_gate_decision_wizard_form" model="ir.ui.view">
        <field name="name">erp.quality.gate.decision.wizard.form</field>
        <field name="model">erp.quality.gate.decision.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="gate_id"/>
                    <field name="decision"/>
                    <field name="system_result"/>
                    <field name="reason" placeholder="Required when rejecting or overriding a failed system result..."/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Confirm" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
